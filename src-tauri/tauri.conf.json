{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeripheralBattery",
  "version": "0.1.2",
  "identifier": "com.peripheralbattery.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "外设电量",
        "width": 720,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "peripheralbattery",
    "copyright": "Copyright (c) 2026 wh23423",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/wh23423/PeripheralBattery",
    "category": "Utility",
    "shortDescription": "Windows 托盘常驻的外设电量面板（鼠标/键盘/耳机/手柄）",
    "longDescription": "PeripheralBattery 是 Windows 托盘常驻的外设电量面板，覆盖 2.4G 接收器、USB 与蓝牙三条链路。安装后常驻托盘，点击托盘图标显示液态玻璃浮动面板，失焦自动隐藏。用户数据保存在 %APPDATA%\\PeripheralBattery，卸载时可选择一并删除。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/collector/": "collector/",
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "minimumWebview2Version": "118.0.0.0",
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer-hooks.nsh",
        "languages": ["English", "SimpChinese"]
      }
    }
  }
}
